<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <changeSet author="tobiowolabi" id="job_posting_migration">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="job_postings"/>
            </not>
        </preConditions>
        <createTable tableName="job_postings">
            <column name="id" type="${uuid_type}" defaultValueComputed="${uuid_function}">
                <constraints nullable="false" primaryKey="true" unique="true"/>
            </column>

            <column name="title" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="duration_in_months" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="number_of_open_positions" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="expiration_date" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="is_cgpa_required" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_resume_required" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_cover_letter_required" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
            <column name="eligible_departments" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="employer_id" type="${uuid_type}">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="tobiowolabi" id="job_posting_application_migration">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="job_posting_applications"/>
            </not>
        </preConditions>
        <createTable tableName="job_posting_applications">
            <column name="id" type="${uuid_type}" defaultValueComputed="${uuid_function}">
                <constraints nullable="false" primaryKey="true" unique="true"/>
            </column>

            <column name="job_posting_id" type="${uuid_type}">
                <constraints nullable="false"/>
            </column>
            <column name="applicant_id" type="${uuid_type}">
                <constraints nullable="false"/>
            </column>
            <column name="resume_link" type="TEXT"/>
            <column name="cover_letter_link" type="TEXT"/>
            <column name="cgpa" type="DECIMAL"/>
            <column name="application_status" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="updates" type="TEXT"/>
            <column name="reject_reason" type="TEXT"/>

            <column name="created_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="tobiowolabi" id="change_isCGpaRequired_to_isTranscriptRequired">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="job_postings" columnName="is_cgpa_required"/>
        </preConditions>

        <renameColumn tableName="job_postings" oldColumnName="is_cgpa_required" newColumnName="is_transcript_required"/>
    </changeSet>

    <changeSet author="tobiowolabi" id="add_transcript_link_to_job_posting_application">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="job_posting_applications" columnName="transcript_link"/>
            </not>
        </preConditions>

        <addColumn tableName="job_posting_applications">
            <column name="transcript_link" type="TEXT" />
        </addColumn>
    </changeSet>

    <changeSet author="tobiowolabi" id="add_monthly_remuneration_to_job_posting">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="job_postings" columnName="monthly_remuneration"/>
            </not>
        </preConditions>

        <addColumn tableName="job_postings">
            <column name="monthly_remuneration" type="DECIMAL" />
        </addColumn>
    </changeSet>

    <changeSet author="tobiowolabi" id="add_location_to_job_posting">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="job_postings" columnName="location"/>
            </not>
        </preConditions>

        <addColumn tableName="job_postings">
            <column name="location" type="VARCHAR(20)" defaultValue="REMOTE"/>
        </addColumn>
    </changeSet>

    <changeSet author="tobiowolabi" id="add_address_state_location_to_job_posting">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="job_postings" columnName="state"/>
                <columnExists tableName="job_postings" columnName="country"/>
                <columnExists tableName="job_postings" columnName="address"/>
            </not>
        </preConditions>

        <addColumn tableName="job_postings">
            <column name="state" type="VARCHAR(50)" defaultValue="LAGOS" />
        </addColumn>
        <addColumn tableName="job_postings">
            <column name="country" type="VARCHAR(50)" defaultValue="NIGERIA"/>
        </addColumn>
        <addColumn tableName="job_postings">
            <column name="address" type="VARCHAR(250)" defaultValue=""/>
        </addColumn>
    </changeSet>

    <changeSet author="tobiowolabi" id="add_industry_to_job_posting">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="job_postings" columnName="industry"/>
            </not>
        </preConditions>

        <addColumn tableName="job_postings">
            <column name="industry" type="VARCHAR(150)" defaultValue="ENGINEERING" />
        </addColumn>
    </changeSet>

</databaseChangeLog>