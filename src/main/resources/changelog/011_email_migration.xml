<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <changeSet author="tobiowolabi" id="email_migration">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="emails"/>
            </not>
        </preConditions>
        <createTable tableName="emails">
            <column name="id" type="${uuid_type}" defaultValueComputed="${uuid_function}">
                <constraints nullable="false" primaryKey="true" unique="true"/>
            </column>

            <column name="sender" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="subject" type="VARCHAR(250)">
                <constraints nullable="false"/>
            </column>
            <column name="body" type="VARCHAR(250)">
                <constraints nullable="false"/>
            </column>
            <column name="body_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="attachments" type="TEXT"/>
            <column name="recipients" type="TEXT"/>
            <column name="cc" type="TEXT"/>
            <column name="bcc" type="TEXT"/>
            <column name="scheduled_date" type="datetime"/>
            <column name="sent_time" type="datetime"/>
            <column name="sent" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>


            <column name="created_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>



</databaseChangeLog>