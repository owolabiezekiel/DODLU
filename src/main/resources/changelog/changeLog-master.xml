    <include file="/changelog/003_faculty_migration.xml"/>
    <include file="/changelog/004_department_migration.xml"/>
    <include file="/changelog/005_profiles_migration.xml"/>
    <include file="/changelog/006_company_migration.xml"/>
    <include file="changelog/007_job_posting_migration.xml"/>
    <include file="changelog/008_placement_migration.xml"/>
    <include file="changelog/009_student_supervisor_migration.xml"/>
    <include file="changelog/010_logbook_and_logbook_entry_migration.xml"/>
    <include file="changelog/011_email_migration.xml"/>
    <include file="changelog/012_student_document_migration.xml"/>
</databaseChangeLog>