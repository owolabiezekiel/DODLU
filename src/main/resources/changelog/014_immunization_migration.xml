<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <changeSet author="tobiowolabi" id="parent_migration">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="parents"/>
            </not>
        </preConditions>
        <createTable tableName="parents">
            <column name="id" type="${uuid_type}" defaultValueComputed="${uuid_function}">
                <constraints nullable="false" primaryKey="true" unique="true"/>
            </column>


            <column name="title" type="VARCHAR(20)" />
            <column name="first_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="phone_number" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>


            <column name="created_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>


    <changeSet author="tobiowolabi" id="child_migration">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="child"/>
            </not>
        </preConditions>
        <createTable tableName="child">
            <column name="id" type="${uuid_type}" defaultValueComputed="${uuid_function}">
                <constraints nullable="false" primaryKey="true" unique="true"/>
            </column>


            <column name="first_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="gender" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="date_of_birth" type="date">
                <constraints nullable="false" />
            </column>
            <column name="parent_id" type="${uuid_type}">
                <constraints nullable="false" foreignKeyName="fk_child_parent"
                             references="parents(id)"/>
            </column>


            <column name="created_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="vaccine_migration" author="tobilobaowolabi">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="vaccine"/>
            </not>
        </preConditions>
        <createTable tableName="vaccine">
            <column name="id" type="${uuid_type}" defaultValueComputed="${uuid_function}">
                <constraints nullable="false" primaryKey="true" unique="true"/>
            </column>

            <column name="age_target" type="VARCHAR(50)">
                <constraints nullable="false" />
            </column>
            <column name="type" type="TEXT">
                <constraints nullable="false" />
            </column>
            <column name="dosage" type="double">
                <constraints nullable="false" />
            </column>
            <column name="dosage_type" type="VARCHAR(20)">
                <constraints nullable="false" />
            </column>
            <column name="route_of_administration" type="VARCHAR(50)">
                <constraints nullable="false" />
            </column>
            <column name="site" type="VARCHAR(250)">
                <constraints nullable="false" />
            </column>

            <column name="created_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="immunization_migration" author="tobilobaowolabi">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="immunization"/>
            </not>
        </preConditions>
        <createTable tableName="immunization">
            <column name="id" type="${uuid_type}" defaultValueComputed="${uuid_function}">
                <constraints nullable="false" primaryKey="true" unique="true"/>
            </column>

            <column name="vaccine_id" type="TEXT">
                <constraints nullable="false" foreignKeyName="fk_immunization_vaccine"
                             references="vaccine(id)"/>
            </column>
            <column name="minimum_administer_date" type="date">
                <constraints nullable="false" />
            </column>
            <column name="administered" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false" />
            </column>
            <column name="date_of_administration" type="date" />

            <column name="created_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="immunization_record_migration" author="tobilobaowolabi">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="immunization_record"/>
            </not>
        </preConditions>
        <createTable tableName="immunization_record">
            <column name="id" type="${uuid_type}" defaultValueComputed="${uuid_function}">
                <constraints nullable="false" primaryKey="true" unique="true"/>
            </column>

            <column name="child_id" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="immunization_id" type="TEXT">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="immuno_record_child_idx" tableName="immunization_record">
            <column name="child_id"/>
        </createIndex>
        <createIndex indexName="immuno_record_immunization_idx" tableName="immunization_record">
            <column name="immunization_id"/>
        </createIndex>
    </changeSet>

