<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <changeSet author="tobiowolabi" id="group_savings_migration">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="group_savings"/>
            </not>
        </preConditions>
        <createTable tableName="group_savings">
            <column name="id" type="${uuid_type}" defaultValueComputed="${uuid_function}">
                <constraints nullable="false" primaryKey="true" unique="true" primaryKeyName="pk_group_savings"/>
            </column>

            <column name="name" type="VARCHAR(250)">
                <constraints nullable="false"/>
            </column>
            <column name="admin_customer_profile_id" type="${uuid_type}">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1728329990253-1" author="tobilobaowolabi (generated)">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="group_saving_users"/>
            </not>
        </preConditions>

        <createTable tableName="group_saving_users">
            <column name="id" type="${uuid_type}" defaultValueComputed="${uuid_function}">
                <constraints nullable="false" primaryKey="true" unique="true" primaryKeyName="pk_group_savings_users"/>
            </column>

            <column name="group_saving_id" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="member_profile_id" type="TEXT">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="1728331253330-1" author="tobilobaowolabi (generated)">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="group_savings" columnName="description"/>
                <columnExists tableName="group_savings" columnName="url"/>
            </not>
        </preConditions>
        <addColumn tableName="group_savings">
            <column name="description" type="TEXT">
                <constraints nullable="false" />
            </column>
        </addColumn>
        <addColumn tableName="group_savings">
            <column name="url" type="VARCHAR(250)" />
        </addColumn>
    </changeSet>

    <changeSet id="1728984502844-1" author="tobilobaowolabi (generated)">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="group_savings" columnName="least_saving_amount"/>
                <columnExists tableName="group_savings" columnName="saving_frequency"/>
                <columnExists tableName="group_savings" columnName="meeting_location"/>
                <columnExists tableName="group_savings" columnName="currency"/>
            </not>
        </preConditions>

        <addColumn tableName="group_savings">
            <column name="least_saving_amount" type="DECIMAL" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="saving_frequency" type="VARCHAR(30)" defaultValue="WEEKLY">
                <constraints nullable="false"/>
            </column>
            <column name="meeting_location" type="TEXT" defaultValue="remote">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(5)" defaultValue="NGN">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
    
    <changeSet id="1739611201428-1" author="owolabiezekiel">
        <preConditions>
            <columnExists tableName="group_savings" columnName="description"/>
            <columnExists tableName="group_savings" columnName="meeting_location"/>
        </preConditions>

        <dropColumn tableName="group_savings" columnName="description"/>
        <dropColumn tableName="group_savings" columnName="meeting_location"/>
    </changeSet>

    <changeSet id="1739611915919-1" author="owolabiezekiel">
        <preConditions>
            <not>
                <columnExists tableName="group_savings" columnName="goals"/>
                <columnExists tableName="group_savings" columnName="vision"/>
                <columnExists tableName="group_savings" columnName="mission"/>
                <columnExists tableName="group_savings" columnName="rules_and_regulations"/>
                <columnExists tableName="group_savings" columnName="membership_requirements"/>
                <columnExists tableName="group_savings" columnName="loan_available"/>
            </not>
        </preConditions>

        <addColumn tableName="group_savings">
            <column name = "goals" type="TEXT"/>
            <column name = "vision" type="TEXT"/>
            <column name = "mission" type="TEXT"/>
            <column name = "rules_and_regulations" type="TEXT"/>
            <column name = "membership_requirements" type="TEXT"/>
            <column name = "loan_support" type="BOOLEAN" defaultValue="false"/>
        </addColumn>

        <createIndex tableName="group_savings" indexName="group_savings_loan_support_index">
            <column name="loan_support"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>