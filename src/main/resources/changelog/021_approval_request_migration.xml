<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <changeSet id="create_approval_request_table" author="tobilobaowolabi (generated)">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="approval_request"/>
            </not>
        </preConditions>

        <createTable tableName="approval_request">
            <column name="id" type="${uuid_type}" defaultValueComputed="${uuid_function}">
                <constraints nullable="false" primaryKey="true" unique="true" primaryKeyName="pk_approval_request"/>
            </column>

            <column name="requester_id" type="TEXT">
                <constraints nullable="false" />
            </column>
            <column name="approver_id" type="TEXT">
                <constraints nullable="false" />
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false" />
            </column>
            <column name="type" type="VARCHAR(50)">
                <constraints nullable="false" />
            </column>
            <column name="workflow_type" type="VARCHAR(50)">
                <constraints nullable="false" />
            </column>
            <column name="request_date" type="TIMESTAMP WITHOUT TIME ZONE">
                <constraints nullable="false" />
            </column>
            <column name="approval_date" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="rejection_date" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="class_path" type="TEXT"/>
            <column name="request_object" type="TEXT"/>

            <column name="created_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="updated_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_approval_request_requester_id"
                     tableName="approval_request">
            <column name="requester_id"/>
        </createIndex>
        <createIndex indexName="idx_approval_request_approver_id"
                     tableName="approval_request">
            <column name="approver_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>