<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">
    <changeSet author="tobiowolabi" id="role_migration">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="role"/>
            </not>
        </preConditions>
        <createTable tableName="role">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" unique="true"/>
            </column>


            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="TEXT">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="modified_date" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="modified_by" type="VARCHAR(100)"/>
        </createTable>
    </changeSet>

    <changeSet author="tobiowolabi" id="create_default_roles">
        <insert tableName="role">
            <column name="description" value="DODLU administrator role"/>
            <column name="name" value="ADMIN"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_by" value="system"/>
            <column name="modified_by" value="system"/>
            <column name="modified_date" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>

        <insert tableName="role">
            <column name="description" value="DODLU lecturer role"/>
            <column name="name" value="LECTURER"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_by" value="system"/>
            <column name="modified_by" value="system"/>
            <column name="modified_date" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>

        <insert tableName="role">
            <column name="description" value="DODLU student role"/>
            <column name="name" value="STUDENT"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_by" value="system"/>
            <column name="modified_by" value="system"/>
            <column name="modified_date" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>
    </changeSet>
</databaseChangeLog>