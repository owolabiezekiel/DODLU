### Get all vaccines
GET {{host}}/vaccine?size=50&page=0&search=week ten
Authorization: {{token}}

### Get single vaccine
GET {{host}}/vaccine/13d067e0-77fa-41d7-8973-ed1f8fb337aa
Authorization: {{token}}

### Get all vaccine count
GET {{host}}/vaccine/count?page=0&size=20&email=ezekiel@gmail
Authorization: {{token}}

### Create Vaccine
POST {{host}}/vaccine
Content-Type: application/json
Authorization: {{token}}

{
  "ageTarget": "WEEK 10",
  "type": "PENTAVALENT1",
  "dosage": 0.5,
  "dosageType": "ML",
  "administerRoute": "INTRAMUSCULAR",
  "administerSite": "Anterolateral aspect of left thigh"
}

### Create Vaccine
PUT {{host}}/vaccine/5f366fdf-d1c5-430b-99dc-41273fd03fc7
Content-Type: application/json
Authorization: {{token}}

{
  "ageTarget": "WEEK_SIX",
  "type": "PENTAVALENT1",
  "dosage": 0.5,
  "dosageType": "ML",
  "administerRoute": "INTRAMUSCULAR",
  "administerSite": "Anterolateral aspect of left thigh"
}